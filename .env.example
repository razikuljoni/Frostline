# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are enabled).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this application is hosted (e.g. https://frostline-plow.vercel.app).
# Used for SEO metadata, OpenGraph links, and API endpoints.
APP_URL="http://localhost:3000"

# OPTIONAL FIREBASE OVERRIDES FOR VERCEL / EXTERNAL DEPLOYMENTS:
# By default, the app uses firebase-applet-config.json. Set these in Vercel to override:
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""

